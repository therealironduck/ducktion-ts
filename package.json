{
  "name": "@therealironduck/ducktion-ts",
  "version": "0.0.0-dev",
  "description": "Simple, flexible dependency injection for Typescript",
  "homepage": "https://github.com/therealironduck/ducktion-ts",
  "bugs": {
    "url": "https://github.com/therealironduck/ducktion-ts/issues"
  },
  "license": "MIT",
  "author": "Jordan Kniest <mail@jkniest.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therealironduck/ducktion-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "esbuild": "^0.28.0",
    "memfs": "^4.57.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.23.0",
    "rollup": "^4.60.3",
    "ts-loader": "^9.5.7",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "unrun": "^0.3.0",
    "vitest": "^4.1.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
